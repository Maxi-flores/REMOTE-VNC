{
  "name": "Supreme Remote Desktop",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "your_secure_password",
      "webPort": 6080
    },
    "ghcr.io/tailscale/codespace/tailscale:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Supreme VNC Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  },
  "runArgs": [
    "--shm-size=1g" 
  ],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y remmina remmina-plugin-rdp"
}
